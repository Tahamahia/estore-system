{
  "name": "estore-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute estore-db --remote --file=./src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute estore-db --local --file=./src/db/schema.sql",
    "db:bootstrap": "wrangler d1 execute estore-db --remote --file=./src/db/bootstrap.sql",
    "db:bootstrap:local": "wrangler d1 execute estore-db --local --file=./src/db/bootstrap.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "bcryptjs": "^3.0.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.105.0"
  }
}
