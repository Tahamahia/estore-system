{
  "manifest_version": 3,
  "name": "eStore Cart Extractor",
  "version": "1.0.0",
  "description": "Extract cart items from Shein & Trendyol with SKU, Size, Color and push to eStore API",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.shein.com/*",
    "*://*.shein.co.uk/*",
    "*://*.shein.com.tr/*",
    "*://*.trendyol.com/*",
    "https://*.workers.dev/*",
    "https://*.pages.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.shein.com/*cart*",
        "*://*.shein.co.uk/*cart*",
        "*://*.shein.com.tr/*cart*",
        "*://*.trendyol.com/*cart*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
